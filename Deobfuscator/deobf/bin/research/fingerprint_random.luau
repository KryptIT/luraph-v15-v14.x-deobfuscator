-- Environment fingerprint for Random: run through deob.py (optionally with
-- --studio / --cfg fake_random=true) and diff the printed lines.
local function show(label, f, ...)
	local r = table.pack(pcall(f, ...))
	local parts = {}
	for i = 1, r.n do
		local v = r[i]
		local s = tostring(v)
		if type(v) == "function" or type(v) == "table" or type(v) == "userdata" or type(v) == "thread" then
			s = type(v) .. "/" .. typeof(v) .. (string.match(s, "^%a+: 0x") and "@addr" or ":" .. s)
		elseif type(v) == "number" then
			s = string.format("%.17g", v)
		end
		parts[i] = s
	end
	print(label .. " = " .. table.concat(parts, " | "))
end
show("type", function() return type(Random), typeof(Random) end)
show("tostringfmt", function() return (string.gsub(tostring(Random), "0x%x+", "ADDR")) end)
show("mt", function() return getmetatable(Random) end)
show("frozen", function() return table.isfrozen(Random) end)
show("keys", function() local k = {} for a, b in pairs(Random) do k[#k + 1] = tostring(a) .. ":" .. type(b) end table.sort(k) return table.concat(k, ",") end)
show("len", function() return #Random end)
show("write", function() Random.x = 1 end)
show("rawget", function() return rawget(Random, "new") == Random.new end)
show("new.same", function() return Random.new == Random.new, rawequal(Random.new, Random.new) end)
show("new.info", function() return debug.info(Random.new, "s"), debug.info(Random.new, "l"), debug.info(Random.new, "n"), debug.info(Random.new, "a") end)
show("new.fenv", function() return getfenv(Random.new) == getfenv(0), getfenv(Random.new) == getfenv() end)
show("new.setfenv", function() return setfenv(Random.new, {}) end)
show("new.tostring", function() return (string.gsub(tostring(Random.new), "0x%x+", "ADDR")) end)
show("new.noarg.type", function() return typeof(Random.new()) end)
show("new.str", function() return Random.new("x") end)
show("new.numstr", function() return Random.new("5"):NextInteger(0, 2147483647) end)
show("new.tbl", function() return Random.new({}) end)
show("new.nil", function() return typeof(Random.new(nil)) end)
show("new.bool", function() return Random.new(true) end)
local r = Random.new(1)
show("obj", function() return type(r), typeof(r) end)
show("obj.tostring", function() return tostring(r) end)
show("obj.mt", function() return getmetatable(r) end)
show("obj.setmt", function() return setmetatable(r, {}) end)
show("obj.eq", function() return r == Random.new(1), rawequal(r, r) end)
show("obj.method.same", function() return r.NextNumber == r.NextNumber, rawequal(r.NextNumber, r.NextNumber) end)
show("obj.method.info", function() return debug.info(r.NextNumber, "s"), debug.info(r.NextNumber, "n"), debug.info(r.NextNumber, "a") end)
show("obj.method.fenv", function() return getfenv(r.NextNumber) == getfenv(0) end)
show("obj.foo", function() return r.Foo end)
show("obj.set", function() r.Foo = 1 end)
show("obj.num", function() return r[1] end)
show("dotcall", function() return r.NextNumber() end)
show("dotcall.wrong", function() return r.NextNumber({}) end)
show("NextInteger()", function() return r:NextInteger() end)
show("NextInteger(1)", function() return r:NextInteger(1) end)
show("NextInteger(str)", function() return Random.new(3):NextInteger("1", "10") end)
show("NextInteger(frac)", function() return Random.new(3):NextInteger(1.5, 9.7) end)
show("NextInteger(rev)", function() return Random.new(3):NextInteger(10, 1) end)
show("NextNumber(1)", function() return Random.new(3):NextNumber(1) end)
show("NextNumber(rev)", function() return Random.new(3):NextNumber(5, 1) end)
show("NextNumber(str)", function() return Random.new(3):NextNumber("a", 2) end)
show("seq", function() local q = Random.new(42) return q:NextInteger(1, 100), q:NextNumber(), q:NextInteger(-1000, 1000) end)
show("clone", function() local q = Random.new(42) q:NextNumber() local c = q:Clone() return typeof(c), c:NextNumber() == q:NextNumber() end)
show("uv", function() local v = Random.new(9):NextUnitVector() return typeof(v), v.X, v.Y, v.Z end)
show("shuffle", function() local t = {1, 2, 3, 4, 5, 6} Random.new(9):Shuffle(t) return table.concat(t, ",") end)
show("shuffle.bad", function() return Random.new(9):Shuffle(5) end)
show("shuffle.frozen", function() return Random.new(9):Shuffle(table.freeze({1, 2, 3})) end)
